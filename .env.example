  # Copia este archivo como .env y completa los valores. .env NO se sube a GitHub.
  #
  # Clave de cifrado (Fernet). Generar con:
  #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
  APP_ENCRYPTION_KEY=
  #
  # Clave para huellas HMAC de seudonimización. Generar con:
  #   python -c "import secrets; print(secrets.token_hex(32))"
  APP_PSEUDO_KEY=
  #
  # Primer administrador (solo se crea si la base de datos no tiene usuarios)
  APP_ADMIN_USER=admin
  APP_ADMIN_EMAIL=admin@ejemplo.cl
  APP_ADMIN_PASSWORD=
  #
  APP_DB_PATH=inventario.db
  APP_MINUTOS_SESION=60
  # APP_ENV=produccion   # oculta /docs
